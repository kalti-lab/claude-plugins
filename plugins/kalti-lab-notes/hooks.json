{
  "kalti-lint": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/lint-on-write.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/lint-before-commit.sh"
          }
        ]
      }
    ]
  }
}
